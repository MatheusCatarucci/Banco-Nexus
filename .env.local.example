# Copie para .env.local e preencha. Nao commite o .env.local.

# Supabase > Project Settings > Data API
# URL do projeto. A service role e server-only: nunca exponha a chave abaixo no cliente.
NEXT_PUBLIC_SUPABASE_URL=https://<seu-ref>.supabase.co

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
# Equivalente a antiga "service_role". Ignore RLS: use so no servidor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Assina o cookie de sessao (HMAC-SHA256).
# Gere um valor aleatorio: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
SESSION_SECRET=
